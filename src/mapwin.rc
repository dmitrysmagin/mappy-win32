#include <windows.h>
#include "mapdefs.h"

/* CREATEPROCESS_MANIFEST_RESOURCE_ID / RT_MANIFEST — not default-manifest.o */
1 24 "mapwin.manifest"

MAPWINIC ICON "mapwin.ico"

MAPACCEL ACCELERATORS 
{
 "^M", CM_FILENEW, ASCII
 "^K", CM_LAYERONION, ASCII
 "^Z", CM_EDITUNDO, ASCII
 "f", CM_TOOLFILL, ASCII
 "^F", CM_TOOLFILLRANDOM, ASCII
 "^R", CM_EDITRESIZE, ASCII
 "o", CM_PICKLAYER, ASCII
 "p", CM_PICKBLOCK, ASCII
 "^I", CM_FILEIMPORT, ASCII
 ",", CM_BLOCKPREV, ASCII
 ".", CM_BLOCKNEXT, ASCII
 "^N", CM_EDITNEW, ASCII
 "^B", CM_BRUSHGRAB, ASCII
 VK_UP, CM_ARROWUP, VIRTKEY
 VK_DOWN, CM_ARROWDOWN, VIRTKEY
 VK_LEFT, CM_ARROWLEFT, VIRTKEY
 VK_RIGHT, CM_ARROWRIGHT, VIRTKEY
 "^G", CM_TOOLGRID, ASCII
 "r", CM_TOOLREVEAL, ASCII
 "^W", CM_TOOLPILLARS, ASCII
 "^O", CM_FILEOPEN, ASCII
 "^S", CM_FILESAVE, ASCII
 "^A", CM_FILESAVEAS, ASCII
 "^X", CM_EDITCUT, ASCII
 "^C", CM_EDITCOPY, ASCII
 "^V", CM_EDITPASTE, ASCII
}


MAPMENU MENU 
{
 POPUP "&File"
 {
  MENUITEM "New &Map...\tCtrl+M", CM_FILENEW
  MENUITEM "&Open...\tCtrl+O", CM_FILEOPEN
  MENUITEM "&Save\tCtrl+S", CM_FILESAVE
  MENUITEM "Save &As...\tCtrl+A", CM_FILESAVEAS
  MENUITEM SEPARATOR
  MENUITEM "&Import...\tCtrl+I", CM_FILEIMPORT
  MENUITEM "Im&port At...", CM_FILEIMPORTAT
   MENUITEM "&Export...", CM_FILEEXPORT
   MENUITEM "Export &textfile...", CM_FILEEXTTXT
   MENUITEM SEPARATOR
  MENUITEM "E&xit", CM_FILEEXIT
 }

 POPUP "&Edit"
 {
  MENUITEM "Un&do\tCtrl+Z", CM_EDITUNDO
  MENUITEM SEPARATOR
  MENUITEM "&New\tCtrl+N", CM_EDITNEW
  MENUITEM "C&ut\tCtrl+X", CM_EDITCUT
  MENUITEM "&Copy\tCtrl+C", CM_EDITCOPY
  MENUITEM "&Paste\tCtrl+V", CM_EDITPASTE
  MENUITEM SEPARATOR
  MENUITEM "&Resize Map...\tCtrl+R", CM_EDITRESIZE
 }

 POPUP "&MapTools"
 {
  MENUITEM "&Map Properties...", CM_TOOLINFO
  MENUITEM SEPARATOR
  MENUITEM "&Anim Preview (DirectX)", CM_TOOLANIMPREVIEW
  MENUITEM "&Preview Setup...", CM_TOOLANIMSETUP
  MENUITEM SEPARATOR
   MENUITEM "&Range Edit Blocks", CM_TOOLRANGE
   POPUP "Use&ful functions"
   {
    MENUITEM "&Halve block dimensions", CM_TOOLHALVE
    MENUITEM "&Convert 16x16 map to 8x8", CM_TOOLCONV16
    MENUITEM "Create map from &big picture...", CM_TOOLBIGPIC
    MENUITEM "Resize block &dimensions...", CM_TOOLRESIZEBLK
    MENUITEM "Save FMP without graphics (.FMA)...", CM_TOOLSAVEFMA
    MENUITEM "&Auto set BG transparency", CM_TOOLAUTOBG
   }
   MENUITEM SEPARATOR
  MENUITEM "Remove &Unused Anims", CM_TOOLREMOVEANIMS
  MENUITEM "Remove Unused &Blocks", CM_TOOLREMOVEBLOCKS
  MENUITEM "Remove Unused &Graphics", CM_TOOLREMOVEGRAPHICS
  MENUITEM "Remove Duplicate Graphics\tCtrl+Shift+G", CM_TOOLDUPGFX
  MENUITEM "Remove Duplicate Blocks\tCtrl+Shift+B", CM_TOOLDUPBLK
  MENUITEM SEPARATOR
  MENUITEM "Show Pillar bases &only\tr", CM_TOOLREVEAL
  MENUITEM "R&iser mode\tCtrl+W", CM_TOOLPILLARS
  MENUITEM SEPARATOR
   MENUITEM "&Grid\tCtrl+G", CM_TOOLGRID
   MENUITEM "&Dividers...", CM_TOOLDIVIDERS
   MENUITEM SEPARATOR
   MENUITEM "3D &walls mode (wnesmode)", CM_TOOLWNES
   MENUITEM "&Rotated tiles mode", CM_TOOLROTATED
   MENUITEM "&Flipped tiles mode", CM_TOOLFLIPPED
   MENUITEM SEPARATOR
   MENUITEM "Show &User data overlay...", CM_SHOWUSER
   MENUITEM "&Custom mouse buttons...", CM_CUSTOMBTN
   MENUITEM "&Layer Adjust...", CM_LYRADJ
   MENUITEM "&Remove Unused/Duplicate...", CM_REMOVE
   MENUITEM SEPARATOR
   MENUITEM "Zoom x &0.25", CM_TOOLZOOM025
   MENUITEM "Zoom x 0&.5", CM_TOOLZOOM05
   MENUITEM "Zoom x &1", CM_TOOLZOOM1
   MENUITEM "Zoom x &2", CM_TOOLZOOM2
   MENUITEM "Zoom x &4", CM_TOOLZOOM4
 }

  POPUP "&Brush"
 {
  MENUITEM "Grab &Brush\tCtrl+B", CM_BRUSHGRAB
  MENUITEM "Grab &New Brush", CM_BRUSHGRABNEW
  MENUITEM "Grab Brush from block &sequence", CM_BRUSHGRABBS
  MENUITEM SEPARATOR
  MENUITEM "Disable brush transparency", CM_BRUSHGRABNT
  MENUITEM SEPARATOR
  MENUITEM "&Rename current brush", CM_BRUSHRENAME
  POPUP "Brush &handle"
  {
   MENUITEM "&Top-left", CM_BRUSHHANDLETL
   MENUITEM "Top-&right", CM_BRUSHHANDLETR
   MENUITEM "&Bottom-left", CM_BRUSHHANDLEBL
   MENUITEM "B&ottom-right", CM_BRUSHHANDLEBR
  }
  MENUITEM SEPARATOR
  MENUITEM "&Destroy All Brushes", CM_BRUSHDESTROY
 }

  POPUP "&Layer"
 {
  MENUITEM "&Add layer", CM_LAYERADD
  MENUITEM "&Duplicate Layer", CM_LAYERDUP
  MENUITEM "&Delete Layer", CM_LAYERDELETE
  MENUITEM "&Clear Layer", CM_LAYERCLEAR
  MENUITEM "&Slide Layer", CM_LAYERSLIDE
  MENUITEM SEPARATOR
  POPUP "Layer &Bank"
  {
   MENUITEM "&0-9", CM_LAYERBANK0
   MENUITEM "&10-19", 337
   MENUITEM "&20-29", 338
   MENUITEM "&30-39", 339
   MENUITEM "&40-49", 340
   MENUITEM "&50-59", 341
   MENUITEM "&60-69", 342
   MENUITEM "&70-79", 343
   MENUITEM "&80-89", 344
   MENUITEM "&90-99", 345
  }
  MENUITEM "Layer 0", CM_LAYERSEL
  MENUITEM "Layer 1", 401
  MENUITEM "Layer 2", 402
  MENUITEM "Layer 3", 403
  MENUITEM "Layer 4", 404
  MENUITEM "Layer 5", 405
  MENUITEM "Layer 6", 406
  MENUITEM "Layer 7", 407
  MENUITEM "Layer 8", 408
  MENUITEM "Layer 9", 409
  MENUITEM "&Go to layer...", CM_LAYERGOTO
  MENUITEM "&Rename layer...", CM_LAYERRENAME
  MENUITEM SEPARATOR
  MENUITEM "Onion S&kin...\tCtrl+K", CM_LAYERONION
  MENUITEM "&Background Layers darkened", CM_LAYERDARK
  MENUITEM "Remove &Marker graphics...", CM_LAYERMARKER
 }

  POPUP "&Objects"
 {
  MENUITEM "&Manager...", CM_OBJMGR
  MENUITEM "&Place mode", CM_OBJPLACE
  MENUITEM "&Show objects", CM_OBJSHOW
 }

  POPUP "Tile&sets"
 {
  MENUITEM "&Manager...", CM_TSMGR
  MENUITEM "&Place mode", CM_TSPLACE
  MENUITEM "&Show tilesets", CM_TSSHOW
  MENUITEM "&Explode selected", CM_TSEXPLODE
 }

  POPUP "&Help"
 {
  MENUITEM "&Contents\tF1", CM_HELPCONTENTS
  MENUITEM "&Edit MAPWIN.INI", CM_HELPINI
  MENUITEM SEPARATOR
  MENUITEM "&About...", CM_HELPABOUT
 }

}

